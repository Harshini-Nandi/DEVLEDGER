# OpenLedger AI - Environment Configuration

# Application
APP_NAME="OpenLedger AI"
APP_ENV=development
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database
DATABASE_URL="sqlite:///./openledger.db"

# Local AI Configuration (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=60

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# Privacy & Retention
DOCUMENT_RETENTION_DAYS=0  # 0 means retain until user deletes
ENABLE_LOCAL_OCR_FALLBACK=True
